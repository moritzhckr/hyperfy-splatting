# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Database (SQLite path or PostgreSQL URI)
DATABASE_URL=./data/auth.db

# Hyperfy Backend (proxied requests)
HYPERFY_URL=http://localhost:3001

# SAML 2.0 Configuration
SAML_ENABLED=false
SAML_ENTRY_POINT=https://your-idp.example.com/saml/sso
SAML_ISSUER=hyperfy-auth-gateway
SAML_CERT=-----BEGIN CERTIFICATE-----\nYOUR_IDP_CERTIFICATE_HERE\n-----END CERTIFICATE-----
SAML_CALLBACK_URL=http://localhost:3000/auth/saml/callback

# Email Configuration
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@example.com

# Email Verification
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_EXPIRY=24h

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SPECIAL=false

# Session Configuration
SESSION_COOKIE_NAME=hyperfy_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=localhost

# CORS
CORS_ORIGIN=http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
